{
  "name": "trader-network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "node --test tests/api.node-test.mjs",
    "test:watch": "vitest",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "db:migrate:local": "wrangler d1 migrations apply trader-network-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trader-network-db --remote",
    "db:list:local": "wrangler d1 execute trader-network-db --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\"",
    "db:list:remote": "wrangler d1 execute trader-network-db --remote --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "webmcp-types": "^0.1.5",
    "wrangler": "^4.128.0"
  }
}
